<% const paginationModel = buildPaginationViewModel({ pagination: typeof pagination !== 'undefined' ? pagination : null, search: typeof search !== 'undefined' ? search : '', queryParams: typeof queryParams !== 'undefined' ? queryParams : null }); %>

<% if (paginationModel) { %>
  <nav class="pagination" aria-label="Pagination">
    <% if (paginationModel.hasPrevious) { %>
      <a href="?page=<%= paginationModel.previousPage %><%= paginationModel.querySuffix %>" class="btn btn-outline btn-sm">
        <i class="ph ph-caret-left"></i> Previous
      </a>
    <% } else { %>
      <button class="btn btn-outline btn-sm" disabled>
        <i class="ph ph-caret-left"></i> Previous
      </button>
    <% } %>

    <div class="pagination-pages">
      <% for (const p of paginationModel.pages) { %>
        <% if (p === '...') { %>
          <span class="pagination-ellipsis">&hellip;</span>
        <% } else if (p === paginationModel.currentPage) { %>
          <span class="pagination-page active"><%= p %></span>
        <% } else { %>
          <a href="?page=<%= p %><%= paginationModel.querySuffix %>" class="pagination-page"><%= p %></a>
        <% } %>
      <% } %>
    </div>

    <% if (paginationModel.hasNext) { %>
      <a href="?page=<%= paginationModel.nextPage %><%= paginationModel.querySuffix %>" class="btn btn-outline btn-sm">
        Next <i class="ph ph-caret-right"></i>
      </a>
    <% } else { %>
      <button class="btn btn-outline btn-sm" disabled>
        Next <i class="ph ph-caret-right"></i>
      </button>
    <% } %>
  </nav>
<% } %>
