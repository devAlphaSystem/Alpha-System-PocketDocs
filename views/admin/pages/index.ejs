<% const isDocumentsSection = section === 'documents'; %>
<% const itemLabel = sectionOption.itemLabel || (isDocumentsSection ? 'page' : 'article'); %>
<% const itemLabelPlural = sectionOption.itemLabelPlural || itemLabel + 's'; %>
<% const selectionItemLabel = isDocumentsSection ? 'sidebar item' : itemLabel; %>
<% const selectionItemLabelPlural = isDocumentsSection ? 'sidebar items' : itemLabelPlural; %>
<% const isSearching = typeof search !== 'undefined' && search; %>
<% const treeItems = typeof pageTreeItems !== 'undefined' ? pageTreeItems : []; %>

<div class="pages-page">
  <div class="page-header">
    <div>
      <% if (typeof nonVersionedMode !== 'undefined' && nonVersionedMode) { %>
        <a href="/admin/projects" class="back-link"><i class="ph ph-arrow-left"></i> Projects</a>
      <% } else { %>
        <a href="/admin/projects/<%= project.id %>" class="back-link"><i class="ph ph-arrow-left"></i> Versions</a>
      <% } %>
    </div>
    <div class="header-actions">
      <a href="<%= publicSectionUrl %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> View Public</a>
      
      <% if ((user.role === 'owner' || user.role === 'admin') && (typeof nonVersionedMode !== 'undefined' && nonVersionedMode)) { %>
        <a href="/admin/projects/<%= project.id %>/edit" class="btn btn-outline"><i class="ph ph-pencil"></i> Edit</a>
      <% } %>

      <% if (user.role === 'owner' || user.role === 'admin') { %>
        <% if (isDocumentsSection) { %>
          <button type="button" class="btn btn-outline" data-dialog-open="createSidebarItemDialog">
            <i class="ph ph-list-plus"></i> Add Sidebar Item
          </button>
        <% } %>
        <button type="button" class="btn btn-outline" data-markdown-import-open>
          <i class="ph ph-upload-simple"></i> Import Markdown
        </button>
        <form id="pageBatchDeleteForm" method="POST" action="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/delete-selected" class="inline-form page-batch-delete-form" data-page-batch-delete-form data-item-label="<%= selectionItemLabel %>" data-item-label-plural="<%= selectionItemLabelPlural %>" data-confirm-title="Remove selected <%= selectionItemLabelPlural %>?" data-confirm-message="Remove the selected <%= selectionItemLabelPlural %>? This cannot be undone." data-confirm-button="Remove Selected" data-confirm-variant="danger" hidden>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="section" value="<%= section %>">
          <button type="submit" class="btn btn-danger">
            <i class="ph ph-trash"></i> Remove Selected
          </button>
        </form>
        <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/new?section=<%= section %>" class="btn btn-primary">
          <i class="ph ph-plus"></i> New <%= isDocumentsSection ? 'Page' : 'Article' %>
        </a>
      <% } %>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><i class="ph ph-check-circle"></i> <%= success %></div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><i class="ph ph-warning-circle"></i> <%= error %></div>
  <% } %>

  <div class="settings-tabs-nav knowledge-base-tabs-nav" role="tablist" aria-label="Content sections">
    <% for (const option of sectionOptions) { %>
      <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages?section=<%= option.value %>" class="settings-tab-btn" role="tab" aria-selected="<%= option.value === section ? 'true' : 'false' %>" tabindex="<%= option.value === section ? '0' : '-1' %>">
        <i class="ph ph-<%= option.icon %>"></i>
        <span><%= option.label %></span>
      </a>
    <% } %>
  </div>

  <% if (pages.length === 0) { %>
    <div class="empty-state small">
      <div class="empty-icon"><i class="ph ph-<%= sectionIcon %>"></i></div>
      <% if (isSearching) { %>
        <h3>No matching <%= itemLabelPlural %></h3>
        <p>No <%= sectionLabel %> <%= itemLabelPlural %> found for "<%= search %>". <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages?section=<%= section %>">Clear search</a></p>
      <% } else { %>
        <h3>No <%= sectionLabel %> <%= itemLabelPlural %> yet</h3>
        <p>Create the first <%= itemLabel %> in this section.</p>
      <% } %>
    </div>
  <% } else if (isSearching) { %>
    <div class="versions-list">
      <% for (const pg of pages) { %>
        <div class="version-card row-link" data-row-link="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/<%= pg.id %>" tabindex="0" aria-label="Open <%= itemLabel %> <%= pg.title %>">
          <div class="version-card-main">
            <div class="version-info">
              <% if (user.role === 'owner' || user.role === 'admin') { %>
                <input type="checkbox" class="page-selection-checkbox" name="pageIds" value="<%= pg.id %>" form="pageBatchDeleteForm" data-page-select aria-label="Select <%= itemLabel %> <%= pg.title %>">
              <% } %>
              <h3 class="page-title"><%= pg.title %></h3>
              <span class="page-slug text-muted">/<%= pg.slug %></span>
            </div>
            <div class="version-actions">
              <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/<%= pg.id %>" class="btn btn-outline" title="Edit"><i class="ph ph-pencil"></i> Edit</a>
              <% if (user.role === 'owner' || user.role === 'admin') { %>
                <form method="POST" action="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/<%= pg.id %>/delete" class="inline-form" data-confirm-title="Delete <%= itemLabel %>?" data-confirm-message="Delete this <%= itemLabel %>?" data-confirm-button="Delete" data-confirm-variant="danger">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-outline btn-danger-text" title="Delete"><i class="ph ph-trash"></i> Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <%- include('../../partials/pagination', { pagination, search, queryParams: { section } }) %>
  <% } else { %>
    <div class="versions-list pages-tree" id="pagesTree" data-sortable-tree data-reorder-url="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/reorder?section=<%= section %>" data-csrf="<%= csrfToken %>" data-sort-success="<%= sectionLabel %> reordered" data-sort-error="Failed to reorder <%= sectionLabel %>">
      <% for (const node of treeItems) { %>
        <% const nodeItemType = node.item_type || pageItemTypes.PAGE; %>
        <% const isNavigationItem = nodeItemType !== pageItemTypes.PAGE; %>
        <div class="version-card page-tree-item<%= isNavigationItem ? ' sidebar-navigation-card sidebar-navigation-' + nodeItemType : ' row-link' %>"<% if (!isNavigationItem) { %> data-row-link="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/<%= node.id %>" tabindex="0" aria-label="Open <%= itemLabel %> <%= node.title %>"<% } else { %> aria-label="Sidebar <%= nodeItemType %><%= nodeItemType === pageItemTypes.HEADER ? ' ' + node.title : '' %>"<% } %> data-id="<%= node.id %>" data-order="<%= node.order %>" data-parent="<%= node.parent || '' %>" draggable="true" style="--depth: <%= node.depth %>">
          <div class="version-card-main">
            <div class="version-info">
              <% if (user.role === 'owner' || user.role === 'admin') { %>
                <input type="checkbox" class="page-selection-checkbox" name="pageIds" value="<%= node.id %>" form="pageBatchDeleteForm" data-page-select aria-label="Select <%= isNavigationItem ? 'sidebar ' + nodeItemType : itemLabel %> <%= node.title %>">
              <% } %>
              <% if (nodeItemType === pageItemTypes.HEADER) { %>
                <i class="ph ph-text-h sidebar-navigation-icon"></i>
                <h3 class="page-title sidebar-header-title"><%= node.title %></h3>
                <span class="sidebar-navigation-badge">Header</span>
              <% } else if (nodeItemType === pageItemTypes.SEPARATOR) { %>
                <i class="ph ph-minus sidebar-navigation-icon"></i>
                <span class="sidebar-separator-preview" aria-hidden="true"></span>
                <span class="sidebar-navigation-badge">Separator</span>
              <% } else { %>
                <h3 class="page-title"><%= node.title %></h3>
                <span class="page-slug text-muted">/<%= node.slug %></span>
              <% } %>
            </div>
            <div class="version-actions page-tree-actions">
              <% if (nodeItemType === pageItemTypes.PAGE) { %>
                <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/<%= node.id %>" class="btn btn-outline" title="Edit"><i class="ph ph-pencil"></i> Edit</a>
              <% } else if (nodeItemType === pageItemTypes.HEADER) { %>
                <button type="button" class="btn btn-outline" data-dialog-open="editSidebarHeaderDialog" data-sidebar-header-edit data-edit-url="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/sidebar-items/<%= node.id %>" data-header-title="<%= node.title %>"><i class="ph ph-pencil"></i> Edit</button>
              <% } else if (nodeItemType === pageItemTypes.SEPARATOR) { %>
                <span class="btn btn-outline sidebar-navigation-edit-spacer" aria-hidden="true"><i class="ph ph-pencil"></i> Edit</span>
              <% } %>
              <% if (user.role === 'owner' || user.role === 'admin') { %>
                <form method="POST" action="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/<%= isNavigationItem ? 'sidebar-items/' + node.id + '/delete' : node.id + '/delete' %>" class="inline-form" data-confirm-title="Delete <%= isNavigationItem ? 'sidebar ' + nodeItemType : itemLabel %>?" data-confirm-message="Delete this <%= isNavigationItem ? 'sidebar ' + nodeItemType : itemLabel %>?" data-confirm-button="Delete" data-confirm-variant="danger">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-outline btn-danger-text" title="Delete"><i class="ph ph-trash"></i> Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <%- include('../../partials/pagination', { pagination, search: '', queryParams: { section } }) %>
  <% } %>
</div>

<% if (user.role === 'owner' || user.role === 'admin') { %>
  <dialog id="markdownImportDialog" class="admin-dialog markdown-import-dialog" data-markdown-import-dialog data-import-url="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/import?section=<%= section %>" data-page-editor-base-url="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages" data-csrf="<%= csrfToken %>" data-max-total-content="<%= markdownImport.MAX_TOTAL_CONTENT_LENGTH %>">
    <div class="dialog-content">
      <div class="dialog-header">
        <h2>Import Markdown</h2>
        <button type="button" class="dialog-close" data-markdown-import-close aria-label="Close">
          <i class="ph ph-x"></i>
        </button>
      </div>
      <form data-markdown-import-form data-save-shortcut="off" novalidate>
        <div class="dialog-body">
          <div class="alert alert-error markdown-import-error" data-markdown-import-error hidden></div>
          <div class="form-group">
            <label for="markdownImportFiles">Markdown files <span class="required">*</span></label>
            <input type="file" id="markdownImportFiles" accept=".md,.markdown,text/markdown,text/plain" multiple data-markdown-import-input data-markdown-import-source="files">
          </div>
          <div class="form-group">
            <label for="markdownImportFolder">Folder</label>
            <input type="file" id="markdownImportFolder" accept=".md,.markdown,text/markdown,text/plain" multiple webkitdirectory directory data-markdown-import-input data-markdown-import-source="folder">
            <p class="form-hint">Existing pages with matching imported slugs will be updated, including their folder placement.</p>
          </div>
          <div class="markdown-import-summary" data-markdown-import-summary hidden></div>
          <ul class="markdown-import-file-list" data-markdown-import-file-list hidden></ul>
        </div>
        <div class="dialog-footer">
          <button type="button" class="btn btn-outline" data-markdown-import-close>Cancel</button>
          <button type="submit" class="btn btn-primary" data-markdown-import-submit disabled><i class="ph ph-upload-simple"></i> Import <%= isDocumentsSection ? 'Pages' : 'Articles' %></button>
        </div>
      </form>
    </div>
  </dialog>

  <% if (isDocumentsSection) { %>
    <dialog id="createSidebarItemDialog" class="admin-dialog" data-sidebar-item-create-dialog>
      <div class="dialog-content">
        <div class="dialog-header">
          <h2>Add Sidebar Item</h2>
          <button type="button" class="dialog-close" data-dialog-close="createSidebarItemDialog" aria-label="Close">
            <i class="ph ph-x"></i>
          </button>
        </div>
        <form method="POST" action="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages/sidebar-items" data-sidebar-item-create-form data-save-shortcut="off">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="dialog-body">
            <div class="form-group">
              <label for="sidebarItemType">Item type</label>
              <select id="sidebarItemType" name="itemType" data-sidebar-item-type>
                <option value="header">Header</option>
                <option value="separator">Separator</option>
              </select>
            </div>
            <div class="form-group" data-sidebar-item-title-group>
              <label for="sidebarItemTitle">Header title <span class="required">*</span></label>
              <input type="text" id="sidebarItemTitle" name="title" required maxlength="200" placeholder="API Reference" data-sidebar-item-title>
            </div>
            <p class="form-hint" data-sidebar-item-help>A header is displayed as a non-clickable label in the public sidebar.</p>
          </div>
          <div class="dialog-footer">
            <button type="button" class="btn btn-outline" data-dialog-close="createSidebarItemDialog">Cancel</button>
            <button type="submit" class="btn btn-primary">Add Item</button>
          </div>
        </form>
      </div>
    </dialog>
  <% } %>
<% } %>

<% if (isDocumentsSection && treeItems.some((item) => (item.item_type || pageItemTypes.PAGE) === pageItemTypes.HEADER)) { %>
  <dialog id="editSidebarHeaderDialog" class="admin-dialog" data-sidebar-header-dialog>
    <div class="dialog-content">
      <div class="dialog-header">
        <h2>Edit Sidebar Header</h2>
        <button type="button" class="dialog-close" data-dialog-close="editSidebarHeaderDialog" aria-label="Close">
          <i class="ph ph-x"></i>
        </button>
      </div>
      <form method="POST" data-sidebar-header-edit-form data-save-shortcut="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="dialog-body">
          <div class="form-group">
            <label for="editSidebarHeaderTitle">Header title <span class="required">*</span></label>
            <input type="text" id="editSidebarHeaderTitle" name="title" required maxlength="200" data-sidebar-header-title>
          </div>
        </div>
        <div class="dialog-footer">
          <button type="button" class="btn btn-outline" data-dialog-close="editSidebarHeaderDialog">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Header</button>
        </div>
      </form>
    </div>
  </dialog>
<% } %>
