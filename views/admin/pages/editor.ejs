<% const isDocumentsSection = section === 'documents'; %>
<% const itemLabel = sectionOption.itemLabel || (isDocumentsSection ? 'page' : 'article'); %>
<% const selectedParentValue = typeof page !== 'undefined' && page ? page.parent : (typeof formValues !== 'undefined' && formValues && formValues.parent ? formValues.parent : ''); %>

<div class="editor-page">
  <div class="page-header">
    <div>
      <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/pages?section=<%= section %>" class="back-link"><i class="ph ph-arrow-left"></i> <%= sectionLabel %></a>
    </div>
    <div class="header-actions">
      <% if (typeof page !== 'undefined' && page) { %>
        <% if (isDocumentsSection) { %>
          <% if (typeof nonVersionedMode !== 'undefined' && nonVersionedMode) { %>
            <a href="/docs/<%= project.slug %>/<%= page.slug %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> Preview</a>
          <% } else { %>
            <a href="/docs/<%= project.slug %>/<%= version.slug %>/<%= page.slug %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> Preview</a>
          <% } %>
        <% } else { %>
          <% if (typeof nonVersionedMode !== 'undefined' && nonVersionedMode) { %>
            <a href="/docs/<%= project.slug %>/_kb/<%= section %>/<%= page.slug %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> Preview</a>
          <% } else { %>
            <a href="/docs/<%= project.slug %>/<%= version.slug %>/_kb/<%= section %>/<%= page.slug %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> Preview</a>
          <% } %>
        <% } %>
      <% } %>
      <button type="submit" form="pageForm" class="btn btn-primary"><i class="ph ph-floppy-disk"></i> Save</button>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><i class="ph ph-warning-circle"></i> <%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><i class="ph ph-check-circle"></i> <%= success %></div>
  <% } %>

  <form id="pageForm" method="POST" action="<%= typeof page !== 'undefined' && page ? '/admin/projects/' + project.id + '/versions/' + version.id + '/pages/' + page.id : '/admin/projects/' + project.id + '/versions/' + version.id + '/pages/new?section=' + section %>" class="editor-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="section" value="<%= section %>">

    <div class="editor-meta">
      <div class="form-row">
        <div class="form-group flex-2">
          <label for="title">Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" placeholder="<%= isDocumentsSection ? 'Getting Started' : 'How do I reset my password?' %>" required maxlength="200" value="<%= typeof page !== 'undefined' && page ? page.title : (typeof formValues !== 'undefined' && formValues && formValues.title ? formValues.title : '') %>" data-page-title-input data-auto-slug-source data-auto-slug-target="slug" data-auto-slug-when-empty="true">
        </div>
        <div class="form-group flex-1">
          <label for="slug">Slug</label>
          <input type="text" id="slug" name="slug" placeholder="<%= isDocumentsSection ? 'getting-started' : 'reset-password' %>" maxlength="120" value="<%= typeof page !== 'undefined' && page ? page.slug : (typeof formValues !== 'undefined' && formValues && formValues.slug ? formValues.slug : '') %>">
        </div>
        <div class="form-group flex-1">
          <label for="icon">Icon (<a href="https://phosphoricons.com/#toolbar" target="_blank" rel="noopener noreferrer">Phosphor</a>)</label>
          <input type="text" id="icon" name="icon" placeholder="<%= isDocumentsSection ? 'book-open' : sectionIcon %>" maxlength="50" value="<%= typeof page !== 'undefined' && page ? (page.icon || '') : (typeof formValues !== 'undefined' && formValues && formValues.icon ? formValues.icon : '') %>" data-page-icon-input>
        </div>
        <div class="form-group flex-1">
          <label for="parent">Parent <%= itemLabel %></label>
          <select id="parent" name="parent">
            <option value="">None (top-level)</option>
            <% if (typeof pages !== 'undefined') { %>
              <% for (const p of pages) { %>
                <% if (typeof page === 'undefined' || !page || p.id !== page.id) { %>
                  <option value="<%= p.id %>"<%= selectedParentValue === p.id ? ' selected' : '' %>><%= p.title %></option>
                <% } %>
              <% } %>
            <% } %>
          </select>
        </div>
      </div>
    </div>

    <div class="editor-content">
      <textarea id="content" name="content"><%= typeof page !== 'undefined' && page ? page.content : (typeof formValues !== 'undefined' && formValues && formValues.content ? formValues.content : '') %></textarea>
    </div>
  </form>
</div>
