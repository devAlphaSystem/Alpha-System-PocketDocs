<div class="editor-page">
  <div class="page-header">
    <div>
      <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base?section=<%= section %>" class="back-link"><i class="ph ph-arrow-left"></i> <%= sectionLabel %></a>
    </div>
    <div class="header-actions">
      <% if (typeof page !== 'undefined' && page) { %>
      <% if (typeof singleVersionMode !== 'undefined' && singleVersionMode) { %>
      <a href="/docs/<%= project.slug %>/_kb/<%= section %>/<%= page.slug %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> Preview</a>
      <% } else { %>
      <a href="/docs/<%= project.slug %>/<%= version.slug %>/_kb/<%= section %>/<%= page.slug %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> Preview</a>
      <% } %>
      <% } %>
      <button type="submit" form="knowledgeBaseForm" class="btn btn-primary"><i class="ph ph-floppy-disk"></i> Save</button>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error"><i class="ph ph-warning-circle"></i> <%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><i class="ph ph-check-circle"></i> <%= success %></div>
  <% } %>

  <form id="knowledgeBaseForm" method="POST" action="<%= typeof page !== 'undefined' && page ? '/admin/projects/' + project.id + '/versions/' + version.id + '/knowledge-base/' + section + '/' + page.id : '/admin/projects/' + project.id + '/versions/' + version.id + '/knowledge-base/' + section + '/new' %>" class="editor-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="editor-meta">
      <div class="form-row">
        <div class="form-group flex-2">
          <label for="title">Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" placeholder="How do I reset my password?" required maxlength="200" value="<%= typeof page !== 'undefined' && page ? page.title : (typeof formValues !== 'undefined' && formValues && formValues.title ? formValues.title : '') %>">
        </div>
        <div class="form-group flex-1">
          <label for="slug">Slug</label>
          <input type="text" id="slug" name="slug" placeholder="reset-password" maxlength="120" value="<%= typeof page !== 'undefined' && page ? page.slug : (typeof formValues !== 'undefined' && formValues && formValues.slug ? formValues.slug : '') %>">
        </div>
        <div class="form-group flex-1">
          <label for="icon">Icon (<a href="https://phosphoricons.com/#toolbar" target="_blank" rel="noopener noreferrer">Phosphor</a>)</label>
          <input type="text" id="icon" name="icon" placeholder="<%= section === 'troubleshooting' ? 'wrench' : 'question' %>" maxlength="50" value="<%= typeof page !== 'undefined' && page ? (page.icon || '') : (typeof formValues !== 'undefined' && formValues && formValues.icon ? formValues.icon : '') %>">
        </div>
        <div class="form-group flex-1">
          <label for="parent">Parent article</label>
          <select id="parent" name="parent">
            <option value="">None (top-level)</option>
            <% if (typeof pages !== 'undefined') { %>
              <% for (const p of pages) { %>
                <% if (typeof page === 'undefined' || !page || p.id !== page.id) { %>
                <% const selectedParent = typeof page !== 'undefined' && page ? page.parent : (typeof formValues !== 'undefined' && formValues && formValues.parent ? formValues.parent : ''); %>
                <option value="<%= p.id %>"<%= selectedParent === p.id ? ' selected' : '' %>><%= p.title %></option>
                <% } %>
              <% } %>
            <% } %>
          </select>
        </div>
      </div>
    </div>

    <div class="editor-content">
      <textarea id="content" name="content"><%= typeof page !== 'undefined' && page ? page.content : (typeof formValues !== 'undefined' && formValues && formValues.content ? formValues.content : '') %></textarea>
    </div>
  </form>
</div>

<script>
  var titleInput = document.getElementById('title');
  var slugInput = document.getElementById('slug');
  var autoSlug = !slugInput.value;

  slugInput.addEventListener('input', function() { autoSlug = false; });
  titleInput.addEventListener('input', function() {
    if (autoSlug) {
      slugInput.value = titleInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
  });
</script>
