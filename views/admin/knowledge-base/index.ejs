<div class="pages-page">
  <div class="page-header">
    <div>
      <% if (typeof singleVersionMode !== 'undefined' && singleVersionMode) { %>
      <a href="/admin/projects" class="back-link"><i class="ph ph-arrow-left"></i> Projects</a>
      <% } else { %>
      <a href="/admin/projects/<%= project.id %>" class="back-link"><i class="ph ph-arrow-left"></i> Versions</a>
      <% } %>
    </div>
    <div class="header-actions">
      <% if (typeof singleVersionMode !== 'undefined' && singleVersionMode) { %>
      <a href="/docs/<%= project.slug %>/_kb/<%= section %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> View Public</a>
      <% } else { %>
      <a href="/docs/<%= project.slug %>/<%= version.slug %>/_kb/<%= section %>" class="btn btn-outline" target="_blank"><i class="ph ph-arrow-square-out"></i> View Public</a>
      <% } %>
      <% if ((user.role === 'owner' || user.role === 'admin') && (typeof singleVersionMode !== 'undefined' && singleVersionMode)) { %>
      <a href="/admin/projects/<%= project.id %>/edit" class="btn btn-outline"><i class="ph ph-pencil"></i> Edit</a>
      <% } %>
      <% if (user.role === 'owner' || user.role === 'admin') { %>
      <button type="button" class="btn btn-outline" data-markdown-import-open>
        <i class="ph ph-upload-simple"></i> Import Markdown
      </button>
      <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/new" class="btn btn-primary">
        <i class="ph ph-plus"></i> New Article
      </a>
      <% } %>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><i class="ph ph-check-circle"></i> <%= success %></div>
  <% } %>

  <div class="settings-tabs-nav knowledge-base-tabs-nav" role="tablist" aria-label="Knowledge Base sections">
    <% for (const option of sectionOptions) { %>
    <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base?section=<%= option.value %>" class="settings-tab-btn" role="tab" aria-selected="<%= option.value === section ? 'true' : 'false' %>" tabindex="<%= option.value === section ? '0' : '-1' %>">
      <i class="ph ph-<%= option.icon %>"></i>
      <span><%= option.label %></span>
    </a>
    <% } %>
  </div>

  <% const isSearching = typeof search !== 'undefined' && search; %>

  <% if (pages.length === 0) { %>
  <div class="empty-state small">
    <div class="empty-icon"><i class="ph ph-question"></i></div>
    <% if (isSearching) { %>
    <h3>No matching articles</h3>
    <p>No <%= sectionLabel %> articles found for "<%= search %>". <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base?section=<%= section %>">Clear search</a></p>
    <% } else { %>
    <h3>No <%= sectionLabel %> articles yet</h3>
    <p>Create the first article in this Knowledge Base section.</p>
    <% } %>
  </div>
  <% } else if (isSearching) { %>
  <div class="versions-list">
    <% for (const pg of pages) { %>
    <div class="version-card row-link" data-row-link="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/<%= pg.id %>" tabindex="0" aria-label="Open Knowledge Base article <%= pg.title %>">
      <div class="version-card-main">
        <div class="version-info">
          <% if (pg.icon) { %><i class="ph ph-<%= pg.icon %> page-icon"></i><% } else { %><i class="ph ph-question page-icon"></i><% } %>
          <h3 class="page-title"><%= pg.title %></h3>
          <span class="page-slug text-muted">/<%= pg.slug %></span>
        </div>
        <div class="version-actions page-tree-actions">
          <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/<%= pg.id %>" class="btn btn-outline" title="Edit"><i class="ph ph-pencil"></i> Edit</a>
          <% if (user.role === 'owner' || user.role === 'admin') { %>
          <form method="POST" action="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/<%= pg.id %>/delete" class="inline-form" data-confirm-title="Delete article?" data-confirm-message="Delete this Knowledge Base article?" data-confirm-button="Delete" data-confirm-variant="danger">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-outline btn-danger-text" title="Delete"><i class="ph ph-trash"></i> Delete</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <%- include('../../partials/pagination', { pagination, search, queryParams: { section } }) %>
  <% } else { %>
  <div class="versions-list pages-tree" id="knowledgeBaseTree" data-sortable-tree data-reorder-url="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/reorder" data-csrf="<%= csrfToken %>">
    <% function renderKnowledgeBaseTree(nodes, depth) { %>
      <% for (const node of nodes) { %>
      <div class="version-card row-link page-tree-item" data-row-link="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/<%= node.id %>" tabindex="0" aria-label="Open Knowledge Base article <%= node.title %>" data-id="<%= node.id %>" data-order="<%= node.order %>" data-parent="<%= node.parent || '' %>" draggable="true" style="--depth: <%= depth %>">
        <div class="version-card-main">
          <div class="version-info">
            <div class="page-tree-handle" title="Drag to reorder"><i class="ph ph-dots-six-vertical"></i></div>
            <% if (node.icon) { %><i class="ph ph-<%= node.icon %> page-icon"></i><% } else { %><i class="ph ph-question page-icon"></i><% } %>
            <h3 class="page-title"><%= node.title %></h3>
            <span class="page-slug text-muted">/<%= node.slug %></span>
          </div>
          <div class="version-actions page-tree-actions">
            <a href="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/<%= node.id %>" class="btn btn-outline" title="Edit"><i class="ph ph-pencil"></i> Edit</a>
            <% if (user.role === 'owner' || user.role === 'admin') { %>
            <form method="POST" action="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/<%= node.id %>/delete" class="inline-form" data-confirm-title="Delete article?" data-confirm-message="Delete this Knowledge Base article?" data-confirm-button="Delete" data-confirm-variant="danger">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-outline btn-danger-text" title="Delete"><i class="ph ph-trash"></i> Delete</button>
            </form>
            <% } %>
          </div>
        </div>
      </div>
      <% if (node.children && node.children.length > 0) { renderKnowledgeBaseTree(node.children, depth + 1); } %>
      <% } %>
    <% } %>
    <% renderKnowledgeBaseTree(pageTree, 0); %>
  </div>

  <%- include('../../partials/pagination', { pagination, search: '', queryParams: { section } }) %>
  <% } %>
</div>

<% if (user.role === 'owner' || user.role === 'admin') { %>
<dialog id="markdownImportDialog" class="admin-dialog markdown-import-dialog" data-markdown-import-dialog data-import-url="/admin/projects/<%= project.id %>/versions/<%= version.id %>/knowledge-base/<%= section %>/import" data-csrf="<%= csrfToken %>" data-max-total-content="<%= markdownImport.MAX_TOTAL_CONTENT_LENGTH %>">
  <div class="dialog-content">
    <div class="dialog-header">
      <h2>Import Markdown Articles</h2>
      <button type="button" class="dialog-close" data-markdown-import-close aria-label="Close">
        <i class="ph ph-x"></i>
      </button>
    </div>
    <form data-markdown-import-form data-save-shortcut="off" novalidate>
      <div class="dialog-body">
        <div class="alert alert-error markdown-import-error" data-markdown-import-error hidden></div>
        <div class="form-group">
          <label for="markdownImportFiles">Markdown files <span class="required">*</span></label>
          <input type="file" id="markdownImportFiles" accept=".md,.markdown,text/markdown,text/plain" multiple data-markdown-import-input data-markdown-import-source="files">
        </div>
        <div class="form-group">
          <label for="markdownImportFolder">Folder</label>
          <input type="file" id="markdownImportFolder" accept=".md,.markdown,text/markdown,text/plain" multiple webkitdirectory directory data-markdown-import-input data-markdown-import-source="folder">
        </div>
        <div class="markdown-import-summary" data-markdown-import-summary hidden></div>
        <ul class="markdown-import-file-list" data-markdown-import-file-list hidden></ul>
      </div>
      <div class="dialog-footer">
        <button type="button" class="btn btn-outline" data-markdown-import-close>Cancel</button>
        <button type="submit" class="btn btn-primary" data-markdown-import-submit disabled><i class="ph ph-upload-simple"></i> Import Articles</button>
      </div>
    </form>
  </div>
</dialog>
<% } %>

<% if (!(typeof search !== 'undefined' && search)) { %>
<script src="<%= assetUrl('/js/sidebar-sort.js') %>"></script>
<% } %>
